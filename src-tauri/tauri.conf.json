{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "novil",
  "version": "0.1.6",
  "identifier": "com.synapse.novil",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "novil",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "devtools": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "externalBin": ["binaries/ollama"],
    "resources": ["binaries/lib"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
